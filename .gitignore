# --- Секреты и данные пользователя -----------------------------------------
# Здесь лежат golden_key и токен Telegram-бота. Никогда не коммитить.
/configs/
.env
.env.*
!.env.example

# Товарные файлы, кэш, настройки уведомлений, авторизованные пользователи
/storage/

# Плагины, установленные пользователем через Telegram, не версионируются:
# это чужой код, который каждый ставит себе сам.
# Штатные плагины проекта - часть поставки, поэтому исключены из игнора явно.
/plugins/*
!/plugins/audit_log.py
!/plugins/price_monitor.py
!/plugins/profit.py
!/plugins/scam_guard.py
!/plugins/unconfirmed_orders.py
!/plugins/sales_stats.py
!/plugins/watchdog.py
# Резервные копии (содержат configs/ целиком)
backup.zip
*.zip

# --- Логи -------------------------------------------------------------------
/logs/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
/venv/
/.venv/
/venv2/
/pyvenv/
/.venv-check/

# --- Среда разработки -------------------------------------------------------
/.idea/
/.vscode/
.DS_Store
test.py
