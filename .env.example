# ============================================================================
#  4FunPay - переменные окружения
# ============================================================================
#
#  Скопируй этот файл в .env и заполни нужные строки:
#      cp .env.example .env
#
#  Файл .env исключён из git (см. .gitignore) - секреты в репозиторий не уйдут.
#
#  Заполнять этот файл НЕ обязательно. Основной способ хранения настроек -
#  configs/_main.cfg, который создаёт мастер первичной настройки, потому что
#  панель управления в Telegram пишет настройки обратно именно туда.
#
#  Переменные окружения нужны, когда секрет не хочется держать в файле
#  конфига: например, при запуске в Docker или когда конфиг лежит в общем
#  хранилище. Значение из окружения ПЕРЕКРЫВАЕТ значение из конфига.
#
#  Важно: если задать golden_key здесь, сменить его командой /golden_key
#  в Telegram уже не получится - бот предупредит об этом и укажет, где менять.
# ============================================================================


# ----------------------------------------------------------------------------
#  Токен FunPay-аккаунта (cookie golden_key)
# ----------------------------------------------------------------------------
#  Где взять:
#    1. Залогинься на funpay.com в браузере.
#    2. Нажми F12 -> вкладка Application (в Firefox: Хранилище).
#    3. Cookies -> https://funpay.com -> строка golden_key.
#    4. Скопируй значение целиком - ровно 32 символа, строчные буквы и цифры.
#
#  Это ключ доступа к аккаунту, равносильный паролю. Не показывай его никому,
#  не вставляй в скриншоты и не коммить в git.
#
#  Cookie перестаёт работать при смене пароля на FunPay и при выходе
#  из всех сессий. Тогда бот напишет об этом в Telegram.
#
# FOURFP_GOLDEN_KEY=


# ----------------------------------------------------------------------------
#  Токен Telegram-бота
# ----------------------------------------------------------------------------
#  Где взять:
#    1. Напиши @BotFather в Telegram.
#    2. /newbot -> задай имя и username бота.
#    3. Скопируй выданную строку вида 1234567890:AAbbCcDdEe...
#
#  Токен даёт полный контроль над ботом: держи его в секрете.
#  Если токен утёк - сделай /revoke у @BotFather и получи новый.
#
# FOURFP_TELEGRAM_TOKEN=


# ----------------------------------------------------------------------------
#  Часовой пояс (используется только в Docker)
# ----------------------------------------------------------------------------
#  Влияет на время в уведомлениях, логах и статистике продаж.
#  Список значений: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
#
TZ=Europe/Kyiv


# ============================================================================
#  Чего здесь НЕТ и почему
# ============================================================================
#
#  admin_ids / список разрешённых пользователей Telegram
#      Задаётся не здесь, а через саму панель управления:
#      напиши боту пароль, затем /menu -> Авторизация.
#      Список хранится в storage/cache/tg_authorized_users.json.
#      После того как авторизовался сам, включи там же блокировку входа
#      по паролю (blockLogin) - тогда даже знающий пароль не войдёт.
#
#  Пароль панели управления
#      Хранится только как bcrypt-хеш в configs/_main.cfg (secretKeyHash).
#      Сам пароль нигде не сохраняется. Задаётся при первичной настройке.
#
#  Прокси, автовыдача, автоответы, тексты уведомлений
#      Всё это - configs/_main.cfg и панель управления в Telegram.
#      Смотри config.example.ini как образец с комментариями.
# ============================================================================
